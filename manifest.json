{
  "id": "lunchmoney-addon",
  "name": "Lunch Money Add-on",
  "version": "0.4.0",
  "description": "Synchronise your Lunch Money cash balances to Wealthfolio",
  "author": "stephen.elson@gmail.com",
  "main": "dist/addon.js",
  "sdkVersion": "3.12.0",
  "minWealthfolioVersion": "3.12.0",
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "network": {
    "allowedHosts": ["api.lunchmoney.dev"]
  },
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "lunch-money"
      },
      {
        "id": "lunch-money-settings",
        "path": "settings"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "lunch-money",
          "route": "lunch-money",
          "label": "Lunch Money",
          "icon": "bank",
          "order": 100
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll", "create"],
      "purpose": "Display and link Lunch Money accounts to Wealthfolio accounts"
    },
    {
      "category": "snapshots",
      "functions": ["save"],
      "purpose": "Sync Lunch Money account balances as point-in-time snapshots"
    },
    {
      "category": "secrets",
      "functions": ["get", "set", "delete", "use"],
      "purpose": "Store Lunch Money API key securely and let Wealthfolio attach it to Lunch Money API requests"
    },
    {
      "category": "portfolio",
      "functions": ["getLatestValuations", "update"],
      "purpose": "Fetch current Wealthfolio cash balances to compare against Lunch Money"
    },
    {
      "category": "network",
      "functions": ["request"],
      "purpose": "Read account balances from the Lunch Money API (api.lunchmoney.dev, GET only)"
    }
  ],
  "keywords": ["wealthfolio", "lunchmoney", "addon"],
  "license": "MIT"
}
